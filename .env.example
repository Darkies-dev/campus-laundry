# ==============================================================
# Laundry Management Web App - Environment Configuration
# ==============================================================

# Flask Settings
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=laundry-secret-key-change-in-production

# Database Backend Toggle:
# Set to 'false' (default) to run instantly with local SQLite (no MySQL setup needed).
# Set to 'true' when you want to connect to your MySQL database.
USE_MYSQL=false

# MySQL Connection Details (used when USE_MYSQL=true)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=laundry_db
